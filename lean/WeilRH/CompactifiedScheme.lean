import WeilRH.ArakelovVariety

/-!
# The category `\Schbar` of compactified schemes (roadmap A4) and `X̄_K` (roadmap D1)

Round 46 of `lean/ROADMAP-arakelov.md`. Source: `latex/notes.tex`, `def:compactified-schemes`
(also labelled `def:projective-inputs`), which follows Flach–Morin 2020, Notation 2.2 and
pp. 520–521, and, for the Arakelov pair, Gillet–Soulé 1990, 5.1.1 (p. 154;
`refs/arakelov/gillet-soule-1990-arithmetic-intersection-theory.pdf`).

`def:compactified-schemes`:
(a) a **compactified scheme** `X̄ = (X, X_∞)`: `X` separated of finite type over `Spec ℤ`, `X_∞` the
    set `X(ℂ)` with complex conjugation `F_∞`, and, when `X` is projective, flat and regular over
    `Spec ℤ`, a Kähler form `ω` on `X(ℂ)` with `F_∞^* ω = −ω`;
(b) `\Schbar`: morphisms are morphisms of schemes `X → Y` together with the induced
    `F_∞`-equivariant map `X(ℂ) → Y(ℂ)`; Kähler forms need not be preserved;
(c) `\Schbar^reg`; (d) `\Schbar^proj`; (e) `\Schbar_1`, generated by the `X̄_K = (Spec 𝓞_K, X_{K,∞})`.

## What is formalized

* `points X` is `X(ℂ) = Hom(Spec ℂ, X)` (over `Spec ℤ` every `ℂ`-point lies over the unique map
  `Spec ℂ → Spec ℤ`), `Finf` is `F_∞ : x ↦ x ∘ Spec(conj)`, an involution (`Finf_Finf`);
  `mapPoints f` is the induced map, which is `F_∞`-equivariant (`mapPoints_Finf`) and functorial.
* `CompactifiedScheme`: (a), with the Kähler datum given through `KahlerDatum` (the analytic
  interface of roadmap decision D2) on every object of **Arakelov type** (`IsArakelovType`:
  proper, flat and regular over `Spec ℤ`).
* `Schbar` is the category of (b): `InducedCategory` over `Scheme`, so a morphism is exactly a
  morphism of schemes and the map on `X(ℂ)` is induced (`Schbar.infty`, equivariant by
  `Schbar.infty_Finf`). `Schbar.forget : Schbar ⥤ Scheme` is fully faithful (`Schbar.forget_faithful`,
  `Schbar.forgetFullyFaithful`).
* `Schbar.reg`, `Schbar.proj` (as `ObjectProperty`s, with their full subcategories) for (c), (d).
  `isEmpty_points_of_finite`: for a variety over a finite field `X(ℂ) = ∅` (the notes' remark that
  such objects are `(X, ∅)`).
* **D1, `X̄_K`.** `Xbar.obj K` is the compactified scheme `(Spec 𝓞_K, X_{K,∞})` (with the honest zero
  Kähler form: `X_∞` is finite). `Xbar.pointsEquiv K : X_∞ ≃ (K →+* ℂ)` carries `F_∞` to complex
  conjugation of embeddings (`pointsEquiv_Finf`). The **orbits of `F_∞` are the infinite places**:
  `Xbar.place K : X_∞ → InfinitePlace K` is surjective (`place_surjective`), its fibres are exactly
  the `F_∞`-orbits (`place_eq_place_iff`), real places are the `F_∞`-fixed points
  (`isReal_place_iff`), and the fibre over `w` has `mult w` elements, `1` for real and `2` for
  complex places (`card_fiber_place`). `Xbar.card_points`: `#X_∞ = [K : ℚ] = r₁ + 2 r₂`.
* `Xbar.mem_proj`, `Xbar.isArakelovType`: `X̄_K ∈ \Schbar^proj` and is of Arakelov type.

## Divergences (recorded in `lean/README.md`)

1. **Projective → proper** in "Arakelov type" and in `\Schbar^proj`, as in `WeilRH.ArakelovVariety`
   (Mathlib has no projective morphisms). Over a finite field, "smooth projective" is likewise
   weakened to smooth proper.
2. **`X_∞` is a set** with an involution (no analytic structure), and the Kähler datum is an
   interface (`KahlerInterface`), as in rounds 44–45.
3. **Pure dimension** in `\Schbar^reg` is not encoded (Mathlib has no equidimensionality predicate
   for schemes); `Schbar.reg` asks only for regularity.
4. `\Schbar_1` (finite disjoint unions of the `X̄_K`) is not built as a subcategory; only its
   connected objects `X̄_K` are constructed. Disjoint unions are left for a later round (they need
   coproducts of schemes and of the Kähler data).
5. Schemes are in universe 0.
-/

open AlgebraicGeometry CategoryTheory Limits NumberField ComplexConjugate

noncomputable section

namespace WeilRH.Arakelov

/-- The structure map `X → Spec ℤ` (unique: `Spec ℤ` is terminal). -/
noncomputable def toSpecZ (X : Scheme.{0}) : X ⟶ Spec (CommRingCat.of ℤ) :=
  specZIsTerminal.from X

lemma toSpecZ_eq {X : Scheme.{0}} (f : X ⟶ Spec (CommRingCat.of ℤ)) : f = toSpecZ X :=
  specZIsTerminal.hom_ext _ _

/-! ### Complex points `X(ℂ)` and `F_∞` -/

/-- **`X(ℂ)`**: the complex points of a scheme over `Spec ℤ`, as morphisms `Spec ℂ → X`. -/
abbrev points (X : Scheme.{0}) : Type := Spec (CommRingCat.of ℂ) ⟶ X

/-- **Complex conjugation `F_∞` on `X(ℂ)`**: `x ↦ x ∘ Spec(conj)`. -/
noncomputable def Finf {X : Scheme.{0}} (x : points X) : points X :=
  (Spec.map ArithmeticVariety.conjC ≫ x : Spec (CommRingCat.of ℂ) ⟶ X)

/-- `F_∞` is an involution of `X(ℂ)`. -/
lemma Finf_Finf {X : Scheme.{0}} (x : points X) : Finf (Finf x) = x := by
  show Spec.map ArithmeticVariety.conjC ≫ Spec.map ArithmeticVariety.conjC ≫ x = x
  rw [← Category.assoc, ← Spec.map_comp, ArithmeticVariety.conjC_conjC, Spec.map_id,
    Category.id_comp]

/-- The map `X(ℂ) → Y(ℂ)` induced by a morphism of schemes. -/
def mapPoints {X Y : Scheme.{0}} (f : X ⟶ Y) (x : points X) : points Y :=
  (x ≫ f : Spec (CommRingCat.of ℂ) ⟶ Y)

/-- The induced map on complex points is `F_∞`-equivariant (`def:compactified-schemes` (b)). -/
lemma mapPoints_Finf {X Y : Scheme.{0}} (f : X ⟶ Y) (x : points X) :
    mapPoints f (Finf x) = Finf (mapPoints f x) :=
  Category.assoc _ _ _

@[simp] lemma mapPoints_id (X : Scheme.{0}) (x : points X) : mapPoints (𝟙 X) x = x :=
  Category.comp_id _

lemma mapPoints_comp {X Y Z : Scheme.{0}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : points X) :
    mapPoints (f ≫ g) x = mapPoints g (mapPoints f x) :=
  (Category.assoc _ _ _).symm

/-- **Varieties over finite fields have no complex points**: if `X` maps to `Spec k` for a finite
field `k`, then `X(ℂ) = ∅` (a ring map `k → ℂ` cannot exist, since `ℂ` has characteristic zero).
This is the notes' remark that such an object is `(X, ∅)`. -/
lemma isEmpty_points_of_finite {X : Scheme.{0}} {k : Type} [Field k] [Finite k]
    (g : X ⟶ Spec (CommRingCat.of k)) : IsEmpty (points X) := by
  refine ⟨fun x => ?_⟩
  let φ : k →+* ℂ := (Spec.preimage (x ≫ g)).hom
  have hp : ringChar k ≠ 0 := by
    have := CharP.char_ne_zero_of_finite k (ringChar k)
    exact this
  have h0 : ((ringChar k : ℕ) : ℂ) = 0 := by
    rw [← map_natCast φ, ringChar.Nat.cast_ringChar, map_zero]
  exact hp (by exact_mod_cast h0)

/-! ### Kähler data and compactified schemes -/

/-- A **Kähler datum** on `X_∞` (through the analytic interface of roadmap D2): an interface
together with a Kähler form `ω` with `F_∞^* ω = −ω` (Flach–Morin, Notation 2.2 and p. 520;
Gillet–Soulé 5.1.1). -/
structure KahlerDatum (P : Type) (F : P → P) where
  /-- The analytic interface on `X_∞`. -/
  I : KahlerInterface P F
  /-- The Kähler form. -/
  ω : I.Forms
  kahler : I.IsKahler ω
  F_ω : I.pullback ω = -ω

/-- The Kähler datum on a finite (0-dimensional) `X_∞`: the zero form. -/
def KahlerDatum.zeroDim (P : Type) (F : P → P) : KahlerDatum P F where
  I := KahlerInterface.zeroDim P F
  ω := PUnit.unit
  kahler := trivial
  F_ω := rfl

/-- `X` is of **Arakelov type**: projective (here: proper), flat and regular over `Spec ℤ`. These
are the objects that carry a Kähler form in `def:compactified-schemes` (a). -/
structure IsArakelovType (X : Scheme.{0}) : Prop where
  proper : IsProper (toSpecZ X)
  flat : Flat (toSpecZ X)
  regular : IsRegularScheme X

/-- **Compactified scheme** (`def:compactified-schemes` (a)): a scheme `X` separated and of finite
type over `Spec ℤ`, with `X_∞ = X(ℂ)` and `F_∞` (`points`, `Finf`), and a Kähler datum on `X_∞`
whenever `X` is of Arakelov type. -/
structure CompactifiedScheme where
  /-- The scheme `X`. -/
  X : Scheme.{0}
  separated : IsSeparated (toSpecZ X)
  locallyOfFiniteType : LocallyOfFiniteType (toSpecZ X)
  quasiCompact : QuasiCompact (toSpecZ X)
  /-- The Kähler datum, present when `X` is projective (proper), flat and regular over `ℤ`. -/
  kahler : IsArakelovType X → KahlerDatum (points X) Finf

/-- **The category `\Schbar`** (`def:compactified-schemes` (b)): a morphism `X̄ → Ȳ` is a morphism
of schemes `X → Y` (the map `X(ℂ) → Y(ℂ)` is induced, and the Kähler forms are not required to
be preserved). -/
abbrev Schbar : Type 1 := InducedCategory Scheme.{0} CompactifiedScheme.X

namespace Schbar

/-- The forgetful functor `\Schbar → Sch`. -/
abbrev forget : Schbar ⥤ Scheme.{0} := inducedFunctor CompactifiedScheme.X

/-- The forgetful functor is **faithful** (a morphism of compactified schemes is determined by its
morphism of schemes). -/
lemma forget_faithful : forget.Faithful := inferInstance

/-- It is moreover fully faithful: every morphism of schemes is a morphism in `\Schbar`, as in
`def:compactified-schemes` (b). -/
def forgetFullyFaithful : forget.FullyFaithful := fullyFaithfulInducedFunctor _

/-- The **induced map on `X_∞`** of a morphism in `\Schbar`. -/
def infty {X Y : Schbar} (f : X ⟶ Y) : points X.X → points Y.X := mapPoints f.hom

/-- The induced map on `X_∞` commutes with `F_∞` (`def:compactified-schemes` (b)). -/
lemma infty_Finf {X Y : Schbar} (f : X ⟶ Y) (x : points X.X) :
    infty f (Finf x) = Finf (infty f x) :=
  mapPoints_Finf _ _

lemma infty_comp {X Y Z : Schbar} (f : X ⟶ Y) (g : Y ⟶ Z) (x : points X.X) :
    infty (f ≫ g) x = infty g (infty f x) :=
  mapPoints_comp _ _ _

/-- `\Schbar^reg` (`def:compactified-schemes` (c)): `X` regular. (Pure dimension is not
encoded; see the module docstring.) -/
def reg : ObjectProperty Schbar := fun X => IsRegularScheme X.X

/-- `X` is smooth and projective (here: proper) over some finite field. -/
def IsSmProjFiniteField (X : Scheme.{0}) : Prop :=
  ∃ (k : Type) (_ : Field k) (_ : Finite k) (g : X ⟶ Spec (CommRingCat.of k)),
    Smooth g ∧ IsProper g

/-- `\Schbar^proj` (`def:compactified-schemes` (d)): `X` projective (here: proper), flat and
regular over `Spec ℤ`, or smooth and projective (here: proper) over a finite field. -/
def proj : ObjectProperty Schbar := fun X => IsArakelovType X.X ∨ IsSmProjFiniteField X.X

/-- Objects of `\Schbar^proj` over finite fields have empty `X_∞`. -/
lemma isEmpty_points_of_smProj {X : Schbar} (h : IsSmProjFiniteField X.X) :
    IsEmpty (points X.X) := by
  obtain ⟨k, _, _, g, -, -⟩ := h
  exact isEmpty_points_of_finite g

end Schbar

/-! ### `X̄_K` (roadmap D1) -/

namespace Xbar

variable (K : Type) [Field K] [NumberField K]

/-- `Spec 𝓞_K`. -/
noncomputable abbrev S : Scheme.{0} := Spec (CommRingCat.of (𝓞 K))

omit [NumberField K] in
lemma toSpecZ_S : toSpecZ (S K) = Spec.map (CommRingCat.ofHom (algebraMap ℤ (𝓞 K))) :=
  (toSpecZ_eq _).symm

/-- `X_{K,∞} = (Spec 𝓞_K)(ℂ) ≃ Hom(𝓞_K, ℂ)`. -/
noncomputable def pointsRingEquiv : points (S K) ≃ (𝓞 K →+* ℂ) where
  toFun x := (Spec.preimage x).hom
  invFun φ := Spec.map (CommRingCat.ofHom φ)
  left_inv x := by
    show Spec.map (CommRingCat.ofHom (Spec.preimage x).hom) = x
    rw [CommRingCat.ofHom_hom, Spec.map_preimage]
  right_inv φ := by
    show (Spec.preimage (Spec.map (CommRingCat.ofHom φ))).hom = φ
    rw [Spec.preimage_map, CommRingCat.hom_ofHom]

/-- **`X_{K,∞} ≃ Hom(K, ℂ)`**: the complex points of `Spec 𝓞_K` are the embeddings of `K`. -/
noncomputable def pointsEquiv : points (S K) ≃ (K →+* ℂ) :=
  ((pointsRingEquiv K).trans (Equiv.subtypeUnivEquiv (ArithmeticRing.mem_embeddings K)).symm).trans
    (ArithmeticVariety.embeddingsEquiv K)

lemma pointsEquiv_comp (x : points (S K)) :
    (pointsEquiv K x).comp (algebraMap (𝓞 K) K) = pointsRingEquiv K x := by
  apply RingHom.ext; intro a
  simp [pointsEquiv, ArithmeticVariety.embeddingsEquiv, IsFractionRing.lift_algebraMap]

omit [NumberField K] in
lemma pointsRingEquiv_Finf (x : points (S K)) :
    pointsRingEquiv K (Finf x) = (starRingEnd ℂ).comp (pointsRingEquiv K x) := by
  show (Spec.preimage (Spec.map ArithmeticVariety.conjC ≫ x)).hom = _
  conv_lhs => rw [← Spec.map_preimage x, ← Spec.map_comp, Spec.preimage_map]
  rfl

/-- Under `X_{K,∞} ≃ Hom(K, ℂ)`, `F_∞` is complex conjugation of embeddings. -/
lemma pointsEquiv_Finf (x : points (S K)) :
    pointsEquiv K (Finf x) = ComplexEmbedding.conjugate (pointsEquiv K x) := by
  -- both sides restrict to `conj ∘ x` on `𝓞_K`, and restriction to `𝓞_K` is injective
  have hinj : ∀ φ ψ : K →+* ℂ,
      φ.comp (algebraMap (𝓞 K) K) = ψ.comp (algebraMap (𝓞 K) K) → φ = ψ := by
    intro φ ψ h
    apply RingHom.ext; intro y
    obtain ⟨a, b, _, rfl⟩ := IsFractionRing.div_surjective (A := 𝓞 K) y
    have ha := RingHom.congr_fun h a
    have hb := RingHom.congr_fun h b
    simp only [RingHom.comp_apply] at ha hb
    rw [map_div₀, map_div₀, ha, hb]
  apply hinj
  rw [pointsEquiv_comp, pointsRingEquiv_Finf, ← pointsEquiv_comp]
  apply RingHom.ext; intro a
  simp [ComplexEmbedding.conjugate_coe_eq]

instance : Finite (points (S K)) := Finite.of_equiv _ (pointsEquiv K).symm

/-- `X̄_K` is of **Arakelov type**: `Spec 𝓞_K → Spec ℤ` is proper (finite), flat, and `Spec 𝓞_K`
is regular. -/
lemma isArakelovType : IsArakelovType (S K) where
  proper := by
    rw [toSpecZ_S]
    have : IsFinite (Spec.map (CommRingCat.ofHom (algebraMap ℤ (𝓞 K)))) := by
      rw [IsFinite.SpecMap_iff, CommRingCat.hom_ofHom]
      exact RingHom.finite_algebraMap.mpr inferInstance
    infer_instance
  flat := by
    rw [toSpecZ_S]
    exact HasRingHomProperty.Spec_iff (P := @Flat).mpr (by
      rw [CommRingCat.hom_ofHom]; exact RingHom.flat_algebraMap_iff.mpr inferInstance)
  regular := isRegularScheme_spec (𝓞 K)

/-- **`X̄_K = (Spec 𝓞_K, X_{K,∞})`** as a compactified scheme, with the zero Kähler form on the
finite set `X_{K,∞}`. -/
noncomputable def obj : CompactifiedScheme where
  X := S K
  separated := by rw [toSpecZ_S]; infer_instance
  locallyOfFiniteType := by
    rw [toSpecZ_S]
    exact HasRingHomProperty.Spec_iff.mpr (by
      rw [CommRingCat.hom_ofHom]
      exact RingHom.finiteType_algebraMap.mpr inferInstance)
  quasiCompact := by rw [toSpecZ_S]; infer_instance
  kahler _ := KahlerDatum.zeroDim _ _

/-- `X̄_K` is an object of `\Schbar^proj`. -/
lemma mem_proj : Schbar.proj (obj K : Schbar) := Or.inl (isArakelovType K)

/-! ### The orbits of `F_∞` are the infinite places -/

/-- The infinite place of a complex point of `X̄_K`. -/
noncomputable def place (x : points (S K)) : InfinitePlace K :=
  InfinitePlace.mk (pointsEquiv K x)

lemma place_surjective : Function.Surjective (place K) := fun w => by
  exact ⟨(pointsEquiv K).symm w.embedding, by simp [place, InfinitePlace.mk_embedding]⟩

/-- **The fibres of `place` are the `F_∞`-orbits**: two complex points define the same infinite
place iff they are equal or exchanged by `F_∞`. -/
lemma place_eq_place_iff (x y : points (S K)) :
    place K x = place K y ↔ x = y ∨ Finf x = y := by
  rw [place, place, InfinitePlace.mk_eq_iff, ← pointsEquiv_Finf, (pointsEquiv K).apply_eq_iff_eq,
    (pointsEquiv K).apply_eq_iff_eq]

/-- **Real places are the `F_∞`-fixed points.** -/
lemma isReal_place_iff (x : points (S K)) : (place K x).IsReal ↔ Finf x = x := by
  rw [place, InfinitePlace.isReal_mk_iff, ComplexEmbedding.isReal_iff, ← pointsEquiv_Finf,
    (pointsEquiv K).apply_eq_iff_eq]

open Classical in
/-- **The orbit over a place `w` has `mult w` points**: one over a real place, two over a complex
place. -/
lemma card_fiber_place (w : InfinitePlace K) :
    Nat.card {x : points (S K) // place K x = w} = InfinitePlace.mult w := by
  rw [← InfinitePlace.card_filter_mk_eq w, ← Nat.card_eq_finsetCard,
    Nat.card_congr ((pointsEquiv K).subtypeEquiv (p := fun x => place K x = w)
      (q := fun φ => φ ∈ Finset.univ.filter (fun φ : K →+* ℂ => InfinitePlace.mk φ = w))
      (fun x => by simp [place]))]

/-- **`#X_{K,∞} = [K : ℚ] = r₁ + 2 r₂`.** -/
lemma card_points :
    Nat.card (points (S K)) = Module.finrank ℚ K ∧
      Nat.card (points (S K)) = InfinitePlace.nrRealPlaces K + 2 * InfinitePlace.nrComplexPlaces K := by
  have h : Nat.card (points (S K)) = Module.finrank ℚ K := by
    rw [Nat.card_congr (pointsEquiv K), Nat.card_eq_fintype_card, Embeddings.card K ℂ]
  exact ⟨h, h.trans (InfinitePlace.card_add_two_mul_card_eq_rank K).symm⟩

end Xbar

end WeilRH.Arakelov

end
