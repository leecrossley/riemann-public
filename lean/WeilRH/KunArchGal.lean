import Mathlib
import WeilRH.KunArchOrderTwo

/-!
# `prop:kun-arch` at `Gal(ℚ(i)/ℚ)` (round 79)

`latex/notes.tex`, `prop:kun-arch`, concerns the nontrivial character `χ` of `Gal(ℚ(i)/ℚ)`, whose
decomposition group at the real place is generated by complex conjugation `c`. Rounds 67 and 71
proved the statement for an abstract group of order two. Here it is instantiated at the actual
Galois group, with `ℚ(i)` encoded as the cyclotomic field `ℚ(ζ₄)` (`CyclotomicField 4 ℚ`):

* `card_gal`: `Gal(ℚ(i)/ℚ)` has order two (via `Gal ≃* (ZMod 4)ˣ`);
* `chi`, `chi_ne_one`: the character `χ = χ₄ ∘ (Gal ≃* (ZMod 4)ˣ)`, which is nontrivial;
* `kun_arch_gal`: for every complex embedding `φ`, there is `c ∈ Gal` that is complex conjugation
  for `φ` (`ComplexEmbedding.IsConj φ c`), `c ≠ 1`, `c` generates the group (so it generates the
  decomposition group at the real place, which is the whole group as `ℚ(i)` is totally complex),
  and `L_∞(χ, s) = Γ_ℝ(s + 1)`, `L_∞(χ², s) = Γ_ℝ(s)`.
-/

open Complex NumberField

namespace WeilRH.KunArch

/-- `L_∞(χ², s) = Γ_ℝ(s)` when `c² = 1`, for any group (no commutativity needed). -/
theorem LInftyChar_sq' {G : Type*} [Group G] (χ : G →* ℂˣ) {c : G} (hc : c ^ 2 = 1)
    (s : ℂ) : LInftyChar (χ ^ 2) c s = Gammaℝ s := by
  have : (χ ^ 2) c = 1 := by
    rw [MonoidHom.pow_apply, ← map_pow, hc, map_one]
  simp [LInftyChar, this]

/-- `ℚ(i)`, as the cyclotomic field `ℚ(ζ₄)`. -/
abbrev QI : Type := CyclotomicField 4 ℚ

noncomputable section

local instance : NeZero ((4 : ℕ) : ℚ) := ⟨by norm_num⟩

local instance : IsCyclotomicExtension {4} ℚ QI := CyclotomicField.isCyclotomicExtension 4 ℚ

/-- `Gal(ℚ(i)/ℚ) ≃* (ZMod 4)ˣ`. -/
def galEquiv : Gal(QI/ℚ) ≃* (ZMod 4)ˣ :=
  IsCyclotomicExtension.autEquivPow QI (Polynomial.cyclotomic.irreducible_rat (by norm_num))

/-- `Gal(ℚ(i)/ℚ)` has order two. -/
theorem card_gal : Nat.card Gal(QI/ℚ) = 2 := by
  rw [Nat.card_congr galEquiv.toEquiv, Nat.card_eq_fintype_card, ZMod.card_units_eq_totient]
  decide

/-- The nontrivial character `χ = χ₄ ∘ (Gal ≃* (ZMod 4)ˣ)` of `Gal(ℚ(i)/ℚ)`, with values in `ℂˣ`. -/
def chi : Gal(QI/ℚ) →* ℂˣ :=
  (Units.map (Int.castRingHom ℂ).toMonoidHom).comp (ZMod.χ₄.toUnitHom.comp galEquiv.toMonoidHom)

theorem chi_ne_one : chi ≠ 1 := by
  intro h
  set u : (ZMod 4)ˣ := ZMod.unitOfCoprime 3 (by norm_num)
  have h1 := congrArg (fun f => ((f (galEquiv.symm u) : ℂˣ) : ℂ)) h
  simp only [chi, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulEquiv.apply_symm_apply,
    Units.coe_map, MonoidHom.one_apply, Units.val_one] at h1
  rw [MulChar.coe_toUnitHom] at h1
  have h3 : ZMod.χ₄ (u : ZMod 4) = -1 := by
    have : (u : ZMod 4) = ((3 : ℕ) : ZMod 4) := rfl
    rw [this, ZMod.χ₄_nat_three_mod_four (by norm_num)]
  rw [h3] at h1
  norm_num at h1

/-- **`prop:kun-arch` at `Gal(ℚ(i)/ℚ)`.** For every complex embedding `φ` of `ℚ(i)`, complex
conjugation for `φ` is an element `c ≠ 1` of `Gal(ℚ(i)/ℚ)` generating the group, and
`L_∞(χ, s) = Γ_ℝ(s + 1)`, `L_∞(χ², s) = Γ_ℝ(s)` for the nontrivial character `χ`. -/
theorem kun_arch_gal (φ : QI →+* ℂ) :
    ∃ c : Gal(QI/ℚ), ComplexEmbedding.IsConj φ c ∧ c ≠ 1 ∧ Subgroup.zpowers c = ⊤ ∧
      ∀ s : ℂ, LInftyChar chi c s = Gammaℝ (s + 1) ∧ LInftyChar (chi ^ 2) c s = Gammaℝ s := by
  have : IsGalois ℚ QI := IsCyclotomicExtension.isGalois {4} ℚ QI
  have : IsTotallyComplex QI := IsCyclotomicExtension.Rat.isTotallyComplex (n := 4) QI (by norm_num)
  have hram : (InfinitePlace.mk φ).IsRamified ℚ :=
    InfinitePlace.isRamified_iff.2 ⟨IsTotallyComplex.isComplex _, by
      rw [show (InfinitePlace.mk φ).comap (algebraMap ℚ QI) = Rat.infinitePlace from
        Subsingleton.elim _ _]
      exact Rat.isReal_infinitePlace⟩
  obtain ⟨c, hc⟩ := InfinitePlace.exists_isConj_of_isRamified hram
  have hc1 : c ≠ 1 := by
    rintro rfl
    have hcx : (InfinitePlace.mk φ).IsComplex := IsTotallyComplex.isComplex _
    rw [InfinitePlace.isComplex_mk_iff] at hcx
    exact hcx (ComplexEmbedding.isConj_one_iff.1 hc)
  obtain ⟨hχ, hc2⟩ := orderTwo_hyp card_gal hc1 chi_ne_one
  refine ⟨c, hc, hc1, ?_, fun s => ⟨LInftyChar_of_ne_one _ hχ s, LInftyChar_sq' _ hc2 s⟩⟩
  -- a nontrivial element of a group of order two generates it
  rw [eq_top_iff]
  intro g _
  obtain ⟨y, -, hy⟩ := (Nat.card_eq_two_iff' (1 : Gal(QI/ℚ))).1 card_gal
  by_cases hg : g = 1
  · rw [hg]; exact Subgroup.one_mem _
  · rw [(hy g hg).trans (hy c hc1).symm]; exact Subgroup.mem_zpowers c


open scoped Classical in
/-- **`prop:kun-arch` at `Gal(ℚ(i)/ℚ)`, with the pole divisors.** For every complex embedding `φ`,
complex conjugation `c ≠ 1` for `φ` generates `Gal(ℚ(i)/ℚ)`, and the pole divisors of
`L_∞(χ, s)` and `L_∞(χ², s)` are `Σ_{n ≥ 0} [-1-2n]` and `Σ_{n ≥ 0} [-2n]` (all simple). -/
theorem kun_arch_gal_divisors (φ : QI →+* ℂ) :
    ∃ c : Gal(QI/ℚ), ComplexEmbedding.IsConj φ c ∧ c ≠ 1 ∧ Subgroup.zpowers c = ⊤ ∧
      (∀ ρ : ℂ, meromorphicOrderAt (LInftyChar chi c) ρ =
        if ∃ n : ℕ, ρ = -1 - 2 * n then -1 else 0) ∧
      (∀ ρ : ℂ, meromorphicOrderAt (LInftyChar (chi ^ 2) c) ρ =
        if ∃ n : ℕ, ρ = -(2 * n) then -1 else 0) := by
  obtain ⟨c, hc, hc1, hgen, hL⟩ := kun_arch_gal φ
  have h1 : LInftyChar chi c = fun s => Gammaℝ (s + 1) := funext fun s => (hL s).1
  have h2 : LInftyChar (chi ^ 2) c = Gammaℝ := funext fun s => (hL s).2
  exact ⟨c, hc, hc1, hgen, fun ρ => by rw [h1]; exact meromorphicOrderAt_Gammaℝ_add_one ρ,
    fun ρ => by rw [h2]; exact meromorphicOrderAt_Gammaℝ ρ⟩

end

end WeilRH.KunArch
