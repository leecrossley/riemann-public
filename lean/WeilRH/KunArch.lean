import Mathlib

/-!
# `prop:kun-arch`: the archimedean factors of `χ` and `χ ⊗ χ`

Round 67 formalization of `latex/notes.tex`, `prop:kun-arch` (claim K-N7).

`def:artin` (b) at a real place `v`: if `σ` restricted to a decomposition group at `v` is
`n₊ · 1 ⊕ n₋ · sgn`, the factor is `Γ_ℝ(s)^{n₊} Γ_ℝ(s + 1)^{n₋}`. For a one-dimensional
character `χ` and a generator `c` (complex conjugation, `c² = 1`) of the decomposition group,
`n₊ = 1, n₋ = 0` if `χ(c) = 1` and `n₊ = 0, n₋ = 1` otherwise (`LInftyChar`).

Mathlib's `Gammaℝ s = π^{-s/2} Γ(s/2)` takes the junk value `0` at its poles; its pole divisor is
the zero divisor of the entire function `1/Γ_ℝ` (`differentiable_Gammaℝ_inv`). We prove:

* `LInftyChar_of_ne_one`, `LInftyChar_sq` (`prop:kun-arch`, first sentence): for `χ(c) ≠ 1`,
  `L_∞(χ, s) = Γ_ℝ(s + 1)` and `L_∞(χ ⊗ χ, s) = Γ_ℝ(s)` (`χ ⊗ χ = χ²` for characters).
* `analyticOrderAt_inv_Gammaℝ_add`, `meromorphicOrderAt_Gammaℝ` (the pole divisor of `Γ_ℝ(s)`
  is `Σ_{n ≥ 0} [-2n]`, all poles simple), and `meromorphicOrderAt_Gammaℝ_add_one` (the pole
  divisor of `Γ_ℝ(s + 1)` is `Σ_{n ≥ 0} [-1-2n]`).
* `conv_D₁_neg_two_sub`, `conv_D₁_eq_zero` (the sum of the pole divisor of `Γ_ℝ(s+1)` with itself
  under `(ρ, ρ') ↦ ρ + ρ'` is `Σ_{k ≥ 0} (k + 1)[-2-2k]`).

The identification of the decomposition group at the real place of `ℚ(i)/ℚ` with the group
generated by complex conjugation, on which `χ` is nontrivial, is not formalized: it enters as the
hypothesis `χ c ≠ 1` with `c ^ 2 = 1`.
-/

open Complex Real

namespace WeilRH.KunArch

/-! ### The archimedean factor of a character at a real place -/

/-- `def:artin` (b) at a real place for a one-dimensional `χ`, with `c` the generator of the
decomposition group: `Γ_ℝ(s)` if `χ(c) = 1` (`n₊ = 1`) and `Γ_ℝ(s + 1)` otherwise (`n₋ = 1`). -/
noncomputable def LInftyChar {G : Type*} [Group G] (χ : G →* ℂˣ) (c : G) (s : ℂ) : ℂ :=
  Gammaℝ s ^ (if χ c = 1 then 1 else 0) * Gammaℝ (s + 1) ^ (if χ c = 1 then 0 else 1)

/-- **`prop:kun-arch`**: `L_∞(χ, s) = Γ_ℝ(s + 1)` when `χ` is nontrivial on the decomposition
group. -/
theorem LInftyChar_of_ne_one {G : Type*} [Group G] (χ : G →* ℂˣ) {c : G} (hχ : χ c ≠ 1)
    (s : ℂ) : LInftyChar χ c s = Gammaℝ (s + 1) := by
  simp [LInftyChar, hχ]

/-- **`prop:kun-arch`**: `L_∞(χ ⊗ χ, s) = Γ_ℝ(s)`, since `χ²(c) = χ(c²) = 1`. -/
theorem LInftyChar_sq {G : Type*} [CommGroup G] (χ : G →* ℂˣ) {c : G} (hc : c ^ 2 = 1)
    (s : ℂ) : LInftyChar (χ ^ 2) c s = Gammaℝ s := by
  have : (χ ^ 2) c = 1 := by
    rw [MonoidHom.pow_apply, ← map_pow, hc, map_one]
  simp [LInftyChar, this]

/-! ### The pole divisor of `Γ_ℝ` -/

/-- `1/Γ_ℝ(s) = s/(2π) · 1/Γ_ℝ(s + 2)` for every `s` (at `s = 0` both sides are `0`). -/
lemma inv_Gammaℝ_eq (s : ℂ) :
    (Gammaℝ s)⁻¹ = s / (2 * π) * (Gammaℝ (s + 2))⁻¹ := by
  rcases eq_or_ne s 0 with rfl | hs
  · have : Gammaℝ 0 = 0 := Gammaℝ_eq_zero_iff.2 ⟨0, by simp⟩
    simp [this]
  · rw [Gammaℝ_add_two hs]
    have hπ : (π : ℂ) ≠ 0 := ofReal_ne_zero.2 Real.pi_ne_zero
    by_cases hG : Gammaℝ s = 0
    · simp [hG]
    · field_simp

/-- Iterating: `1/Γ_ℝ(s) = (∏_{k ≤ n} (s + 2k)/(2π)) · 1/Γ_ℝ(s + 2(n + 1))`. -/
lemma inv_Gammaℝ_eq_prod (n : ℕ) (s : ℂ) :
    (Gammaℝ s)⁻¹ = (∏ k ∈ Finset.range (n + 1), (s + 2 * k) / (2 * π)) *
      (Gammaℝ (s + 2 * (n + 1)))⁻¹ := by
  induction n with
  | zero => simpa using inv_Gammaℝ_eq s
  | succ n ih =>
    rw [ih, inv_Gammaℝ_eq (s + 2 * (n + 1)), Finset.prod_range_succ _ (n + 1)]
    push_cast
    rw [show s + 2 * ((n : ℂ) + 1) + 2 = s + 2 * ((n : ℂ) + 1 + 1) by ring, mul_assoc]

/-- The cofactor `H` with `1/Γ_ℝ(s + c) = (s - ρ) H(s)` at `ρ = -2n - c`. -/
noncomputable def cofactor (c : ℂ) (n : ℕ) (s : ℂ) : ℂ :=
  (∏ k ∈ Finset.range n, (s + c + 2 * k) / (2 * π)) / (2 * π) *
    (Gammaℝ (s + c + 2 * (n + 1)))⁻¹

lemma inv_Gammaℝ_add_eq (c : ℂ) (n : ℕ) (s : ℂ) :
    (Gammaℝ (s + c))⁻¹ = (s - (-(2 * n) - c)) * cofactor c n s := by
  rw [inv_Gammaℝ_eq_prod n (s + c), Finset.prod_range_succ, cofactor]
  ring

lemma cofactor_ne_zero (c : ℂ) (n : ℕ) : cofactor c n (-(2 * n) - c) ≠ 0 := by
  have hπ : (2 * π : ℂ) ≠ 0 := mul_ne_zero two_ne_zero (ofReal_ne_zero.2 Real.pi_ne_zero)
  rw [cofactor]
  refine mul_ne_zero (div_ne_zero (Finset.prod_ne_zero_iff.2 fun k hk => ?_) hπ) ?_
  · refine div_ne_zero ?_ hπ
    have hk : (k : ℂ) - n ≠ 0 := by
      rw [sub_ne_zero]; exact_mod_cast (Finset.mem_range.1 hk).ne
    have : -(2 * (n : ℂ)) - c + c + 2 * k = 2 * (k - n) := by ring
    rw [this]; exact mul_ne_zero two_ne_zero hk
  · have : -(2 * (n : ℂ)) - c + c + 2 * (n + 1) = 2 := by ring
    rw [this]
    exact inv_ne_zero (Gammaℝ_ne_zero_of_re_pos (by simp))

lemma differentiable_cofactor (c : ℂ) (n : ℕ) : Differentiable ℂ (cofactor c n) := by
  have hG : Differentiable ℂ fun s : ℂ => (Gammaℝ (s + c + 2 * (n + 1)))⁻¹ :=
    differentiable_Gammaℝ_inv.comp (by fun_prop)
  unfold cofactor
  refine Differentiable.mul (Differentiable.div_const ?_ _) hG
  have h := Differentiable.finsetProd (u := Finset.range n)
    (f := fun (k : ℕ) (s : ℂ) => (s + c + 2 * k) / (2 * π)) (fun k _ => by fun_prop)
  convert h using 1
  ext s
  simp [Finset.prod_apply]

/-- The zeros of `s ↦ 1/Γ_ℝ(s + c)`: simple at `-2n - c`. -/
theorem analyticOrderAt_inv_Gammaℝ_add (c : ℂ) (n : ℕ) :
    analyticOrderAt (fun s => (Gammaℝ (s + c))⁻¹) (-(2 * n) - c) = 1 := by
  have han : AnalyticAt ℂ (fun s => (Gammaℝ (s + c))⁻¹) (-(2 * n) - c) :=
    (differentiable_Gammaℝ_inv.comp (by fun_prop)).analyticAt _
  rw [show ((1 : ℕ∞)) = ((1 : ℕ) : ℕ∞) from rfl, han.analyticOrderAt_eq_natCast]
  refine ⟨cofactor c n, (differentiable_cofactor c n).analyticAt _, cofactor_ne_zero c n,
    Filter.Eventually.of_forall fun s => ?_⟩
  rw [inv_Gammaℝ_add_eq c n s, pow_one, smul_eq_mul]

/-- Off `{-2n - c}`, `s ↦ 1/Γ_ℝ(s + c)` does not vanish. -/
theorem analyticOrderAt_inv_Gammaℝ_add_eq_zero (c : ℂ) {ρ : ℂ}
    (hρ : ∀ n : ℕ, ρ ≠ -(2 * n) - c) :
    analyticOrderAt (fun s => (Gammaℝ (s + c))⁻¹) ρ = 0 := by
  refine analyticOrderAt_eq_zero.2 (Or.inr (inv_ne_zero fun h => ?_))
  obtain ⟨n, hn⟩ := Gammaℝ_eq_zero_iff.1 h
  exact hρ n (by rw [← hn]; ring)

open scoped Classical in
/-- The pole divisor of `s ↦ Γ_ℝ(s + c)`, as a meromorphic order: `-1` at `-2n - c` and `0`
elsewhere. -/
theorem meromorphicOrderAt_Gammaℝ_add (c ρ : ℂ) :
    meromorphicOrderAt (fun s => Gammaℝ (s + c)) ρ =
      if ∃ n : ℕ, ρ = -(2 * n) - c then -1 else 0 := by
  have han : AnalyticAt ℂ (fun s => (Gammaℝ (s + c))⁻¹) ρ :=
    (differentiable_Gammaℝ_inv.comp (by fun_prop)).analyticAt _
  have hinv : (fun s => Gammaℝ (s + c)) = (fun s => (Gammaℝ (s + c))⁻¹)⁻¹ := by
    ext s; simp
  rw [hinv, meromorphicOrderAt_inv, han.meromorphicOrderAt_eq]
  split_ifs with h
  · obtain ⟨n, rfl⟩ := h
    rw [analyticOrderAt_inv_Gammaℝ_add]; rfl
  · push Not at h
    rw [analyticOrderAt_inv_Gammaℝ_add_eq_zero c h]; rfl

open scoped Classical in
/-- **`prop:kun-arch`**: the divisor of poles of `Γ_ℝ(s)` is `Σ_{n ≥ 0} [-2n]` (all simple). -/
theorem meromorphicOrderAt_Gammaℝ (ρ : ℂ) :
    meromorphicOrderAt Gammaℝ ρ = if ∃ n : ℕ, ρ = -(2 * n) then -1 else 0 := by
  simpa using meromorphicOrderAt_Gammaℝ_add 0 ρ

open scoped Classical in
/-- The divisor of poles of `Γ_ℝ(s + 1)` is `Σ_{n ≥ 0} [-1-2n]` (all simple). -/
theorem meromorphicOrderAt_Gammaℝ_add_one (ρ : ℂ) :
    meromorphicOrderAt (fun s => Gammaℝ (s + 1)) ρ =
      if ∃ n : ℕ, ρ = -1 - 2 * n then -1 else 0 := by
  rw [meromorphicOrderAt_Gammaℝ_add]
  congr 1
  apply propext; constructor <;> rintro ⟨n, hn⟩ <;> exact ⟨n, by rw [hn]; ring⟩

/-! ### The sum of the pole divisor of `Γ_ℝ(s + 1)` with itself -/

/-- The pole divisor of `Γ_ℝ(s + 1)`: `D₁ = Σ_{n ≥ 0} [-1-2n]`. -/
noncomputable def D₁ (ρ : ℂ) : ℕ := by
  classical exact if ∃ n : ℕ, ρ = -1 - 2 * n then 1 else 0

/-- The sum of two divisors under `(ρ, ρ') ↦ ρ + ρ'`: `(D * D')(λ) = Σ_{ρ+ρ'=λ} D(ρ) D'(ρ')`. -/
noncomputable def conv (D D' : ℂ → ℕ) (lam : ℂ) : ℕ := by
  classical exact ∑ᶠ p : ℂ × ℂ, if p.1 + p.2 = lam then D p.1 * D' p.2 else 0

lemma D₁_ne_zero {ρ : ℂ} (h : D₁ ρ ≠ 0) : ∃ n : ℕ, ρ = -1 - 2 * n := by
  classical
  by_contra hc; exact h (by simp [D₁, hc])

lemma D₁_le_one (ρ : ℂ) : D₁ ρ ≤ 1 := by
  classical
  unfold D₁; split_ifs <;> simp

/-- **`prop:kun-arch`**: `(D₁ * D₁)(-2 - 2k) = k + 1`. -/
theorem conv_D₁_neg_two_sub (k : ℕ) : conv D₁ D₁ (-2 - 2 * k) = k + 1 := by
  classical
  let g : ℕ × ℕ → ℂ × ℂ := fun mn => (-1 - 2 * mn.1, -1 - 2 * mn.2)
  have hg : Function.Injective g := by
    intro a b h
    simp only [g, Prod.mk.injEq, sub_right_inj, mul_right_inj' (two_ne_zero' ℂ),
      Nat.cast_inj] at h
    exact Prod.ext h.1 h.2
  set S := (Finset.HasAntidiagonal.antidiagonal k).image g
  have hsupp : (Function.support fun p : ℂ × ℂ =>
      if p.1 + p.2 = -2 - 2 * (k : ℂ) then D₁ p.1 * D₁ p.2 else 0) ⊆ S := by
    intro p hp
    simp only [Function.mem_support, ne_eq, ite_eq_right_iff, Classical.not_imp] at hp
    obtain ⟨hsum, hne⟩ := hp
    obtain ⟨m, hm⟩ := D₁_ne_zero (left_ne_zero_of_mul hne)
    obtain ⟨n, hn⟩ := D₁_ne_zero (right_ne_zero_of_mul hne)
    have hmn : m + n = k := by
      rw [hm, hn] at hsum
      have : ((m + n : ℕ) : ℂ) = k := by push_cast; linear_combination -hsum / 2
      exact_mod_cast this
    exact Finset.mem_image.2 ⟨(m, n), Finset.HasAntidiagonal.mem_antidiagonal.2 hmn,
      Prod.ext hm.symm hn.symm⟩
  unfold conv
  rw [finsum_eq_sum_of_support_subset _ hsupp, Finset.sum_image fun a _ b _ h => hg h]
  have hone : ∀ mn ∈ Finset.HasAntidiagonal.antidiagonal k,
      (if (g mn).1 + (g mn).2 = -2 - 2 * (k : ℂ) then D₁ (g mn).1 * D₁ (g mn).2 else 0) = 1 := by
    intro mn hmn
    have hmn' := Finset.HasAntidiagonal.mem_antidiagonal.1 hmn
    have h1 : D₁ (g mn).1 = 1 := by simp only [D₁, g]; rw [ite_cond_eq_true _ _ (eq_true ⟨mn.1, rfl⟩)]
    have h2 : D₁ (g mn).2 = 1 := by simp only [D₁, g]; rw [ite_cond_eq_true _ _ (eq_true ⟨mn.2, rfl⟩)]
    have h3 : (g mn).1 + (g mn).2 = -2 - 2 * (k : ℂ) := by
      simp only [g]
      rw [← hmn']; push_cast; ring
    rw [ite_cond_eq_true _ _ (eq_true h3), h1, h2]
  rw [Finset.sum_congr rfl hone, Finset.sum_const, Finset.Nat.card_antidiagonal, smul_eq_mul,
    mul_one]

/-- **`prop:kun-arch`**: `(D₁ * D₁)(λ) = 0` unless `λ = -2 - 2k`; in particular `0` does not lie
in its support, while it lies in the pole divisor of `Γ_ℝ(s)`. -/
theorem conv_D₁_eq_zero {lam : ℂ} (h : ∀ k : ℕ, lam ≠ -2 - 2 * k) : conv D₁ D₁ lam = 0 := by
  classical
  unfold conv
  refine finsum_eq_zero_of_forall_eq_zero fun p => ?_
  split_ifs with hsum
  · by_contra hne
    obtain ⟨m, hm⟩ := D₁_ne_zero (left_ne_zero_of_mul hne)
    obtain ⟨n, hn⟩ := D₁_ne_zero (right_ne_zero_of_mul hne)
    exact h (m + n) (by rw [← hsum, hm, hn]; push_cast; ring)
  · rfl

end WeilRH.KunArch
