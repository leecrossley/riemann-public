import Mathlib
import WeilRH.DedekindZetaConv

/-!
# Multiplicativity of the ideal count and the Euler product of `ζ_K`

Round 62 groundwork, continuing `WeilRH.DedekindZetaConv`.

Let `a_K(n) = #{I ⊆ 𝓞_K : N I = n}` (`DedekindZetaConv.coeff`).

* `splitEquiv`: for coprime `m, n`, the map `I ↦ (I ⊔ (m), I ⊔ (n))` is a bijection from ideals
  of norm `m n` to pairs of ideals of norms `m` and `n`, with inverse `(J, J') ↦ J J'`.
  The proof uses only `absNorm I ∈ I`, multiplicativity of `absNorm`, and the fact that
  coprime ideals multiply to their intersection.
* `coeff_mul`: `a_K(m n) = a_K(m) a_K(n)` for coprime `m, n`.
* `dedekindZeta_eulerProduct_hasProd`, `dedekindZeta_eulerProduct_tprod`: for `Re s > 1`,
  `ζ_K(s) = ∏'_p ∑'_e a_K(p^e) p^{-e s}` over rational primes `p`, via Mathlib's
  `EulerProduct.eulerProduct_hasProd`.

**Not proved here:** that the product is nonzero. The local factors
`∑_e a_K(p^e) X^e` equal `∏_{𝔭 ∣ p} (1 - X^{f_𝔭})⁻¹`, which needs the splitting of `p`
into prime ideals; an infinite product of nonzero factors can still tend to `0` without
summability of `log`-type bounds. So `ζ_K(s) ≠ 0` on `Re s > 1` (hence `NonvanishingRight`)
is still recorded as a gap in `lean/README.md`.
-/

namespace WeilRH.DedekindEuler

open NumberField Ideal Filter
open WeilRH.DedekindZetaConv WeilRH WeilRH.Arakelov.ZetaOrder

variable {K : Type*} [Field K] [NumberField K]

set_option linter.unusedSectionVars false

local notation "R" K => 𝓞 K

/-- Coprime integers generate coprime principal ideals of `𝓞_K`. -/
lemma span_sup_span_eq_top {m n : ℕ} (h : Nat.Coprime m n) :
    span {(m : R K)} ⊔ span {(n : R K)} = ⊤ := by
  rw [← Ideal.isCoprime_iff_sup_eq, Ideal.isCoprime_span_singleton_iff]
  have : IsCoprime (m : ℤ) n := Nat.isCoprime_iff_coprime.mpr h
  simpa using this.map (Int.castRingHom (R K))

/-- `N(m) = m^[K:ℚ]` for the principal ideal generated by a natural number. -/
lemma absNorm_span_natCast (m : ℕ) :
    absNorm (span {(m : R K)}) = m ^ Module.finrank ℚ K := by
  rw [absNorm_span_singleton]
  have : ((m : ℕ) : R K) = algebraMap ℤ (R K) (m : ℤ) := by simp
  rw [this, Algebra.norm_algebraMap, RingOfIntegers.rank]
  simp [Int.natAbs_pow]

/-- An ideal containing `m` has norm dividing `m^[K:ℚ]`. -/
lemma absNorm_dvd_pow_of_mem {J : Ideal (R K)} {m : ℕ} (h : (m : R K) ∈ J) :
    absNorm J ∣ m ^ Module.finrank ℚ K := by
  have := absNorm_dvd_absNorm_of_le ((span_singleton_le_iff_mem _).mpr h)
  rwa [absNorm_span_natCast] at this

lemma coprime_absNorm_of_mem {J : Ideal (R K)} {m n : ℕ} (hmn : Nat.Coprime m n)
    (h : (m : R K) ∈ J) : Nat.Coprime (absNorm J) n :=
  Nat.Coprime.coprime_dvd_left (absNorm_dvd_pow_of_mem h) (Nat.Coprime.pow_left _ hmn)

lemma natCast_absNorm_mem (I : Ideal (R K)) {k : ℕ} (hI : absNorm I = k) : (k : R K) ∈ I := by
  rw [← hI]; exact absNorm_mem I

/-- For `N I = m n` with `m, n` coprime, `(I + (m)) (I + (n)) = I`. -/
lemma sup_mul_sup_eq {I : Ideal (R K)} {m n : ℕ} (hmn : Nat.Coprime m n)
    (hI : absNorm I = m * n) :
    (I ⊔ span {(m : R K)}) * (I ⊔ span {(n : R K)}) = I := by
  apply le_antisymm
  · rw [Ideal.sup_mul, Ideal.mul_sup, Ideal.mul_sup]
    refine sup_le (sup_le Ideal.mul_le_left Ideal.mul_le_left) (sup_le Ideal.mul_le_right ?_)
    rw [span_singleton_mul_span_singleton, span_singleton_le_iff_mem, ← Nat.cast_mul]
    exact natCast_absNorm_mem I hI
  · have htop : (I ⊔ span {(m : R K)}) ⊔ (I ⊔ span {(n : R K)}) = ⊤ := by
      refine top_le_iff.mp ?_
      rw [← span_sup_span_eq_top (K := K) hmn]
      exact sup_le_sup le_sup_right le_sup_right
    rw [Ideal.mul_eq_inf_of_coprime htop]
    exact le_inf le_sup_left le_sup_left

/-- If `J` has norm `m`, `J'` has norm `n`, and `m, n` are coprime, then `J J' + (m) = J`. -/
lemma mul_sup_eq {J J' : Ideal (R K)} {m n : ℕ} (hmn : Nat.Coprime m n)
    (hJ : absNorm J = m) (hJ' : absNorm J' = n) :
    J * J' ⊔ span {(m : R K)} = J := by
  have hmJ : (m : R K) ∈ J := natCast_absNorm_mem J hJ
  have hnJ' : (n : R K) ∈ J' := natCast_absNorm_mem J' hJ'
  apply le_antisymm
  · exact sup_le Ideal.mul_le_left ((span_singleton_le_iff_mem _).mpr hmJ)
  · have htop : J' ⊔ span {(m : R K)} = ⊤ := by
      refine top_le_iff.mp ?_
      rw [← span_sup_span_eq_top (K := K) hmn.symm]
      exact sup_le_sup ((span_singleton_le_iff_mem _).mpr hnJ') le_rfl
    calc J = J * (J' ⊔ span {(m : R K)}) := by rw [htop, Ideal.mul_top]
      _ = J * J' ⊔ J * span {(m : R K)} := Ideal.mul_sup _ _ _
      _ ≤ J * J' ⊔ span {(m : R K)} := sup_le_sup le_rfl Ideal.mul_le_right

/-- Arithmetic step: if `a b = m n`, `a ∣ m`, `b ∣ n` and `m n ≠ 0`, then `a = m`. -/
lemma eq_of_mul_eq_of_dvd {a b m n : ℕ} (h : a * b = m * n) (ha : a ∣ m) (hb : b ∣ n)
    (hmn : m * n ≠ 0) : a = m := by
  obtain ⟨c, rfl⟩ := ha
  obtain ⟨e, rfl⟩ := hb
  have hab : a * b ≠ 0 := by rw [h]; exact hmn
  have : a * b * (c * e) = a * b * 1 := by
    calc a * b * (c * e) = a * c * (b * e) := by ring
      _ = a * b := h.symm
      _ = a * b * 1 := (mul_one _).symm
  have hce : c * e = 1 := Nat.eq_of_mul_eq_mul_left (Nat.pos_of_ne_zero hab) this
  rw [Nat.eq_one_of_mul_eq_one_right hce, mul_one]

/-- Norms of the two components. -/
lemma absNorm_sup_eq {I : Ideal (R K)} {m n : ℕ} (hmn : Nat.Coprime m n) (hm : m ≠ 0)
    (hn : n ≠ 0) (hI : absNorm I = m * n) :
    absNorm (I ⊔ span {(m : R K)}) = m ∧ absNorm (I ⊔ span {(n : R K)}) = n := by
  set a := absNorm (I ⊔ span {(m : R K)})
  set b := absNorm (I ⊔ span {(n : R K)})
  have hab : a * b = m * n := by
    rw [← hI, ← map_mul, sup_mul_sup_eq hmn hI]
  have hcopa : Nat.Coprime a n :=
    coprime_absNorm_of_mem hmn (Ideal.mem_sup_right (mem_span_singleton_self _))
  have hcopb : Nat.Coprime b m :=
    coprime_absNorm_of_mem hmn.symm (Ideal.mem_sup_right (mem_span_singleton_self _))
  have ha : a ∣ m := hcopa.dvd_of_dvd_mul_right ⟨b, by rw [← hab]⟩
  have hb : b ∣ n := hcopb.dvd_of_dvd_mul_left ⟨a, by rw [← hab, mul_comm]⟩
  have hmn0 : m * n ≠ 0 := mul_ne_zero hm hn
  have ham : a = m := eq_of_mul_eq_of_dvd hab ha hb hmn0
  refine ⟨ham, ?_⟩
  have hab' : b * a = n * m := by rw [mul_comm, hab, mul_comm]
  exact eq_of_mul_eq_of_dvd hab' hb ha (by rw [mul_comm]; exact hmn0)

/-- The splitting bijection `{N I = m n} ≃ {N J = m} × {N J' = n}` for coprime nonzero `m, n`. -/
noncomputable def splitEquiv {m n : ℕ} (hmn : Nat.Coprime m n) (hm : m ≠ 0) (hn : n ≠ 0) :
    {I : Ideal (R K) // absNorm I = m * n} ≃
      {J : Ideal (R K) // absNorm J = m} × {J : Ideal (R K) // absNorm J = n} where
  toFun I := (⟨I.1 ⊔ span {(m : R K)}, (absNorm_sup_eq hmn hm hn I.2).1⟩,
    ⟨I.1 ⊔ span {(n : R K)}, (absNorm_sup_eq hmn hm hn I.2).2⟩)
  invFun p := ⟨p.1.1 * p.2.1, by rw [map_mul, p.1.2, p.2.2]⟩
  left_inv I := Subtype.ext (sup_mul_sup_eq hmn I.2)
  right_inv p := by
    obtain ⟨⟨J, hJ⟩, ⟨J', hJ'⟩⟩ := p
    refine Prod.ext (Subtype.ext ?_) (Subtype.ext ?_)
    · exact mul_sup_eq hmn hJ hJ'
    · show J * J' ⊔ span {(n : R K)} = J'
      rw [mul_comm]; exact mul_sup_eq hmn.symm hJ' hJ

/-- `a_K(0) = 1`: the only ideal of norm `0` is `⊥`. -/
lemma coeff_zero : coeff K 0 = 1 := by
  have : {I : Ideal (R K) // absNorm I = 0} ≃ Unit :=
    { toFun := fun _ => (), invFun := fun _ => ⟨⊥, absNorm_bot⟩,
      left_inv := fun I => Subtype.ext (absNorm_eq_zero_iff.mp I.2).symm,
      right_inv := fun _ => rfl }
  simp [coeff, Nat.card_congr this]

/-- **Multiplicativity:** `a_K(m n) = a_K(m) a_K(n)` for coprime `m, n`. -/
theorem coeff_mul {m n : ℕ} (hmn : Nat.Coprime m n) :
    coeff K (m * n) = coeff K m * coeff K n := by
  rcases Nat.eq_zero_or_pos m with rfl | hm
  · rw [Nat.coprime_zero_left] at hmn; subst hmn; simp [coeff_one]
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · rw [Nat.coprime_zero_right] at hmn; subst hmn; simp [coeff_one]
  simp only [coeff]
  rw [Nat.card_congr (splitEquiv hmn hm.ne' hn.ne'), Nat.card_prod, Nat.cast_mul]

/-- The Dedekind `L`-series summand `n ↦ a_K(n) n^{-s}`. -/
noncomputable def summand (K : Type*) [Field K] [NumberField K] (s : ℂ) (n : ℕ) : ℂ :=
  LSeries.term (fun n => (coeff K n : ℂ)) s n

lemma summand_one (s : ℂ) : summand K s 1 = 1 := by
  simp [summand, coeff_one]

lemma summand_zero (s : ℂ) : summand K s 0 = 0 := LSeries.term_zero _ _

lemma summand_mul (s : ℂ) {m n : ℕ} (hmn : Nat.Coprime m n) :
    summand K s (m * n) = summand K s m * summand K s n := by
  rcases eq_or_ne m 0 with rfl | hm
  · simp [summand_zero]
  rcases eq_or_ne n 0 with rfl | hn
  · simp [summand_zero]
  simp only [summand, LSeries.term_of_ne_zero (mul_ne_zero hm hn), LSeries.term_of_ne_zero hm,
    LSeries.term_of_ne_zero hn, coeff_mul hmn, Nat.cast_mul, Complex.ofReal_mul]
  rw [Complex.natCast_mul_natCast_cpow]
  field_simp

lemma summable_norm_summand {s : ℂ} (hs : 1 < s.re) : Summable (fun n => ‖summand K s n‖) :=
  summable_norm_iff.mpr (LSeriesSummable_coeff K hs)

/-- **Euler product** of the Dedekind zeta function over rational primes, `Re s > 1`. -/
theorem dedekindZeta_eulerProduct_hasProd {s : ℂ} (hs : 1 < s.re) :
    HasProd (fun p : Nat.Primes => ∑' e : ℕ, summand K s ((p : ℕ) ^ e)) (dedekindZeta K s) := by
  have h := EulerProduct.eulerProduct_hasProd (f := summand K s) (summand_one s)
    (fun hmn => summand_mul s hmn) (summable_norm_summand hs) (summand_zero s)
  rwa [show (∑' n, summand K s n) = dedekindZeta K s by
    rw [dedekindZeta_eq]; rfl] at h

theorem dedekindZeta_eulerProduct_tprod {s : ℂ} (hs : 1 < s.re) :
    ∏' p : Nat.Primes, ∑' e : ℕ, summand K s ((p : ℕ) ^ e) = dedekindZeta K s :=
  (dedekindZeta_eulerProduct_hasProd hs).tprod_eq

/-! ### Reduction of `ζ_K ≠ 0` to the local factors -/

/-- The local factor at `p` minus its constant term `1`: `∑_{e ≥ 1} a_K(p^e) p^{-e s}`. -/
noncomputable def localTail (K : Type*) [Field K] [NumberField K] (s : ℂ) (p : Nat.Primes) : ℂ :=
  ∑' e : ℕ, summand K s ((p : ℕ) ^ (e + 1))

lemma summable_summand {s : ℂ} (hs : 1 < s.re) : Summable (summand K s) :=
  LSeriesSummable_coeff K hs

lemma summable_norm_pow_succ {s : ℂ} (hs : 1 < s.re) :
    Summable (fun x : Nat.Primes × ℕ => ‖summand K s ((x.1 : ℕ) ^ (x.2 + 1))‖) := by
  have hinj : Function.Injective (fun x : Nat.Primes × ℕ => (x.1 : ℕ) ^ (x.2 + 1)) := by
    intro x y h
    obtain ⟨h1, h2⟩ := Nat.Prime.pow_inj x.1.2 y.1.2 h
    exact Prod.ext (Subtype.ext h1) h2
  exact (summable_norm_summand hs).comp_injective hinj

/-- The local factor is `1 + localTail`. -/
lemma localFactor_eq {s : ℂ} (hs : 1 < s.re) (p : Nat.Primes) :
    ∑' e : ℕ, summand K s ((p : ℕ) ^ e) = 1 + localTail K s p := by
  have hinj : Function.Injective (fun e : ℕ => (p : ℕ) ^ e) :=
    Nat.pow_right_injective p.2.two_le
  have hsum : Summable (fun e : ℕ => summand K s ((p : ℕ) ^ e)) :=
    (summable_summand hs).comp_injective hinj
  rw [hsum.tsum_eq_zero_add, pow_zero, summand_one]
  rfl

lemma summable_norm_localTail {s : ℂ} (hs : 1 < s.re) :
    Summable (fun p : Nat.Primes => ‖localTail K s p‖) := by
  have H := (summable_prod_of_nonneg (fun _ => norm_nonneg _)).mp (summable_norm_pow_succ (K := K) hs)
  refine H.2.of_nonneg_of_le (fun _ => norm_nonneg _) (fun p => ?_)
  exact norm_tsum_le_tsum_norm (H.1 p)

/-- **`ζ_K(s) ≠ 0` reduces to the local factors.** If every local factor
`∑_e a_K(p^e) p^{-e s}` is nonzero, then `ζ_K(s) ≠ 0` (`Re s > 1`). -/
theorem dedekindZeta_ne_zero_of_localFactor_ne_zero {s : ℂ} (hs : 1 < s.re)
    (hloc : ∀ p : Nat.Primes, ∑' e : ℕ, summand K s ((p : ℕ) ^ e) ≠ 0) :
    dedekindZeta K s ≠ 0 := by
  rw [← dedekindZeta_eulerProduct_tprod hs]
  simp_rw [localFactor_eq hs]
  exact tprod_one_add_ne_zero_of_summable (fun p => by rw [← localFactor_eq hs]; exact hloc p)
    (summable_norm_localTail hs)

/-- Consequently the `NonvanishingRight` hypothesis of rounds 50/60 reduces to the
nonvanishing of the local Euler factors on `Re s > 1`. -/
theorem nonvanishingRight_of_localFactor_ne_zero {C : DedekindContinuation K}
    (P : C.SimplePoles)
    (hloc : ∀ s : ℂ, 1 < s.re → ∀ p : Nat.Primes, ∑' e : ℕ, summand K s ((p : ℕ) ^ e) ≠ 0) :
    NonvanishingRight P :=
  nonvanishingRight_of_dedekindZeta_ne_zero P
    (fun s hs => dedekindZeta_ne_zero_of_localFactor_ne_zero hs (hloc s hs))

end WeilRH.DedekindEuler
